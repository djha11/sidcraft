DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-at-least-32-random-characters
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Android Studio emulator uses 10.0.2.2 to reach the Windows host.
# For a physical phone, replace this with the computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://10.0.2.2:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Set this after linking the Expo app to an EAS project.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Production email OTP delivery (https://resend.com). Development shows a safe emulator preview.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Ollama Cloud news drafting. Create a key at https://ollama.com/settings/keys.
# Keep the key on the API server only. "local" is optional; "off" uses source excerpts.
PULSE_NEWS_AI_PROVIDER=ollama_cloud
OLLAMA_API_KEY=
PULSE_NEWS_MODEL=nemotron-3-nano:30b
# Only used when PULSE_NEWS_AI_PROVIDER=local.
PULSE_NEWS_LLM_URL=http://127.0.0.1:11434
