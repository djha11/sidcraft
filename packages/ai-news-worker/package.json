{
  "name": "@pulse/ai-news-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "once": "tsx src/main.ts --once",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:once": "node dist/main.js --once",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
