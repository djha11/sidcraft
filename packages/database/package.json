  "dependencies": { "drizzle-orm": "^0.44.5", "postgres": "^3.4.7" },
  "devDependencies": { "@types/node": "^24.3.0", "drizzle-kit": "^0.31.4", "tsx": "^4.20.5", "typescript": "^5.9.2" }
